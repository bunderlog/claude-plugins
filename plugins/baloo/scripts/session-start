#!/bin/sh
# baloo's one Hook (PRD louie): at session start, in a repo, the index of the project's ADRs,
# PRDs, Issues and terms (PRD index), how many items the Inbox holds (ADR inbox) and the files in
# .about/ git hasn't committed (ADR about-folder), for Claude to tell the user. What it prints
# Claude Code adds to Claude's context. It prints nothing outside a repo, in the home folder or
# Claude Code's own, and in a Session review's session; nothing of .about/'s changes in a headless
# one.
set -u

[ -n "${BALOO_SESSION_REVIEW:-}" ] && exit 0
dir=${CLAUDE_PROJECT_DIR:-$PWD}
root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || exit 0
own=${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}
case $root in
  "${HOME:-/nonexistent}" | "$own" | "$own"/*) exit 0 ;;
esac

out=""

# The index of the project's knowledge (PRD index): each ADR, PRD and Issue by its file name and
# title, and the glossary's terms, read from the working tree each time, cut at 8,000 characters.
set --
for f in "$root"/.about/adr/*.md "$root"/.about/prd/*.md "$root"/.about/issues/*.md \
  "$root"/.about/glossary.md; do
  [ -f "$f" ] && set -- "$@" "$f"
done
if [ $# -gt 0 ]; then
  index=$(awk -v limit=8000 '
    function emit(s) { print s; used += length(s) + 1 }
    BEGIN {
      label["adr"] = "ADRs"; label["prd"] = "PRDs"; label["issues"] = "Issues"
      for (i = 1; i < ARGC; i++) {
        rel = ARGV[i]; sub(/.*\/\.about\//, "", rel)
        fenced = 0
        if (rel == "glossary.md") {
          while ((getline line < ARGV[i]) > 0) {
            if (line ~ /^```/) { fenced = !fenced; continue }
            if (!fenced && line ~ /^\*\*[^*]+\*\*:/) {
              sub(/^\*\*/, "", line); sub(/\*\*:.*/, "", line); terms[++nterms] = line
            }
          }
        } else {
          k = rel; sub(/\/.*/, "", k); name = rel; sub(/.*\//, "", name); sub(/\.md$/, "", name)
          title = ""
          while ((getline line < ARGV[i]) > 0) {
            if (line ~ /^```/) { fenced = !fenced; continue }
            if (!fenced && line ~ /^# /) { title = substr(line, 3); break }
          }
          item[k, ++n[k]] = "- " name (title == "" ? "" : ": " title)
        }
        close(ARGV[i])
      }
      if (n["adr"] + n["prd"] + n["issues"] > 0) {
        say = "Before a task'"'"'s first edit, read the ADR, PRD or Issue above that it touches, and say where the code already breaks it"
      }
      if (nterms > 0) {
        say = say (say == "" ? "Write" : "; write") " the glossary'"'"'s terms as it uses them"
      }
      if (say == "") exit
      # Room kept for the lines saying what was cut and for the instruction.
      room = limit - length(say) - 400
      split("adr prd issues", kinds, " ")
      for (j = 1; j <= 3; j++) {
        k = kinds[j]
        if (!n[k]) continue
        if (cut) { emit(label[k] ": " n[k] " more in .about/" k "/"); continue }
        emit(label[k] ", each .about/" k "/<name>.md:")
        for (m = 1; m <= n[k]; m++) {
          if (used + length(item[k, m]) + 1 > room) {
            cut = 1; emit("- and " n[k] - m + 1 " more in .about/" k "/"); break
          }
          emit(item[k, m])
        }
      }
      if (nterms > 0) {
        if (cut) emit("Terms: " nterms " more in .about/glossary.md")
        else {
          s = "Terms in .about/glossary.md: "
          for (m = 1; m <= nterms; m++) {
            t = (m > 1 ? ", " : "") terms[m]
            if (used + length(s) + length(t) + 1 > room) {
              s = s ", and " nterms - m + 1 " more"; break
            }
            s = s t
          }
          emit(s)
        }
      }
      emit(say)
    }
  ' "$@")
  [ -n "$index" ] && out="$out
$index"
fi

inbox=$root/.about/inbox.md
if [ -f "$inbox" ]; then
  # One item per `## ` heading outside a fenced code block; kept, where the line after its heading
  # ends ` · kept YYYY-MM-DD`.
  counts=$(awk '
    /^```/ { fenced = !fenced; dated = 1; next }
    fenced { next }
    /^## / { n++; dated = 0; next }
    !dated && /[^[:space:]]/ {
      dated = 1
      if ($0 ~ / · kept [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9][[:space:]]*$/) kept++
    }
    END { print n + 0, kept + 0 }
  ' "$inbox")
  n=${counts% *} kept=${counts#* }
  if [ "$n" -gt 0 ]; then
    if [ "$n" -eq 1 ]; then items="1 item"; else items="$n items"; fi
    left=""
    if [ "$kept" -eq "$n" ]; then
      left=", each gone through once and kept"
    elif [ "$kept" -gt 0 ]; then
      left=", $((n - kept)) not gone through yet"
    fi
    out="$out
.about/inbox.md holds $items to consider$left: tell the user, and that /baloo:inbox goes through them"
  fi
fi

case ${CLAUDE_CODE_ENTRYPOINT:-} in
  sdk-*) ;;
  *)
    files=$(git -C "$root" status --porcelain -z --untracked-files=all -- .about 2>/dev/null |
      tr '\0' '\n' |
      awk 'skip { skip = 0; next }
        { path = substr($0, 4); if (substr($0, 1, 1) ~ /[RC]/) skip = 1 }
        path ~ /^\.about\// && path !~ /^\.about\/proposals\// { print path }' |
      sort | awk 'NR > 1 { printf ", " } { printf "%s", $0 }')
    if [ -n "$files" ]; then
      out="$out
.about/ has changes git hasn't committed: $files: tell the user, and that committing them is theirs"
    fi
    ;;
esac

[ -n "$out" ] && printf 'baloo:%s\n' "$out"
exit 0
