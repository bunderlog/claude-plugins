# The deploy's secrets, which `mise run deploy` gives Kamal through .kamal/secrets. Copy this file
# to .env, which is never committed, and fill in each value, with no quotes around it.

# The registry's user, and a token of it that can push and pull the image; for ghcr.io, your
# GitHub user and a token with write:packages.
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=
# The production Postgres's password: URL-safe, since it goes into DATABASE_URL, such as the output
# of `openssl rand -hex 32`.
POSTGRES_PASSWORD=
