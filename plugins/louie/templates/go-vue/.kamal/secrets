# The deploy's secrets, which Kamal reads from the environment that `mise run deploy` fills from
# .env (.env.example names each). Nothing here is a secret itself: commit no value to this file.
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
# The server's address of the db accessory: __NAME__-db is its host name on Kamal's network.
DATABASE_URL=postgres://__NAME__:$POSTGRES_PASSWORD@__NAME__-db:5432/__NAME__?sslmode=disable
